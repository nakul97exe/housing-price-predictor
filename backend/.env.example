# Copy this file to .env and fill in the values
# NEVER commit .env to GitHub

FLASK_APP=app.py
FLASK_ENV=production
FLASK_PORT=8000

# Comma-separated — add your Azure Static Web Apps URL here
CORS_ORIGIN=http://localhost:3000

# Model file paths (relative to backend folder)
MODEL_PATH=california_housing_model.pkl
TRANSFORMER_PATH=power_transformer.pkl
FEATURES_PATH=feature_columns.pkl

# OpenRouter API key (get from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Azure Blob Storage — for downloading model files on startup in production
# Leave blank for local development (uses local .pkl files)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=models
